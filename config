# ---------- 字体 ----------
font-family = JetBrainsMono Nerd Font
font-size = 18.0
font-thicken = false

# ---------- 窗口 ----------
window-padding-x = 5
window-padding-y = 5
background-opacity = 1
# background-blur = 30
window-save-state = never
macos-titlebar-style = hidden
window-decoration = auto

# ---------- 光标 ----------
cursor-style = block
cursor-style-blink = false

# ---------- 鼠标 ----------
mouse-hide-while-typing = true

# ---------- macOS 特定 ----------
macos-option-as-alt = true

# ---------- 主题 (Catppuccin Mocha) ----------
# theme = Catppuccin Mocha

# ---------- 快捷键映射 ----------

keybind = clear
# 兼容 nvim 键位: Ctrl+` → Ctrl+_
keybind = ctrl+grave_accent=text:\x1f


# 默认键位
# ⌘⇧, → 重载配置
keybind = cmd+shift+,=reload_config
# ⌘, → 打开配置文件（相关项）
keybind = cmd+,=open_config
# ⌘= → 放大字号
keybind = cmd+==increase_font_size:1
# ⌘+ → 放大字号（第二入口）
keybind = cmd++=increase_font_size:1
# ⌘- → 缩小字号
keybind = cmd+-=decrease_font_size:1
# ⌘Q → 退出
keybind = super+q=quit
# 键盘上的 Copy 键（如有）
keybind = copy=copy_to_clipboard:mixed
# 键盘上的 Paste 键（如有）
keybind = paste=paste_from_clipboard
# ⌘C → 复制
keybind = cmd+c=copy_to_clipboard:mixed
# ⌘V → 粘贴
keybind = cmd+v=paste_from_clipboard
# ⌘⇧V → 粘贴主选择
keybind = cmd+shift+v=paste_from_selection

